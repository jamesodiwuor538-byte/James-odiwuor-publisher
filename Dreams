}

.cover {
  background: #14213d;
  color: white;
  padding: 55px 15px;
  min-height: 220px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.cover h3 {
  font-size: 25px;
}

.price {
  color: #008000;
  font-size: 23px;
  font-weight: bold;
}

button {
  background: #fca311;
  border: none;
  padding: 14px 25px;
  border-radius: 6px;
  font-size: 16px;
  cursor: pointer;
}

.about {
  background: white;
  padding: 30px 20px;
